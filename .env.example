# ============================================================
#  Backend admin — Vercel Postgres (Neon) + Vercel Blob
#  Copiez ce fichier en `.env` pour le développement local.
#  ⚠️  Ne placez AUCUNE de ces variables dans un fichier client.
#      Seules les variables `VITE_*` arrivent au navigateur.
# ============================================================

# ─── Base de données (OBLIGATOIRE) ───────────────────────────
# Lien de connexion Neon. Jamais exposé au client : pas de préfixe VITE_.
# Neon : https://console.neon.tech → Connection string → pooled
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ─── Sécurité admin (OBLIGATOIRE en production) ──────────────
# Clé de signature de la session (32 caractères minimum).
# Générez-la avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_SECRET=

# Hash scrypt du mot de passe admin, au format `salt:hash`.
# Générez-le avec :
#   npm run hash-password
# ADMIN_PASSWORD_HASH=

# Email admin — sert uniquement à identifier l'auteur des modifications
# (empreinte SHA-256 tronquée, jamais stockée en clair). Optionnel.
# ADMIN_EMAIL=

# ─── Stockage des images (OPTIONNEL) ─────────────────────────
# Sans cette variable, l'upload d'images est désactivé : l'admin
# accepte uniquement des URLs d'images déjà en ligne.
# Vercel Blob : https://vercel.com/dashboard → Storage → Blob → token
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ─── Analytics (OPTIONNEL) ───────────────────────────────────
# Google Analytics. Vide = désactivé.
VITE_GA_ID=